# ==============================================================================
# MANGAL PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Database (PostgreSQL + Prisma)
# Default assumes local PostgreSQL on standard port 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mangal_dev?schema=public

# Redis & Caching
# Set REDIS_ENABLED=false or REDIS_URL="" to automatically engage In-Memory Fallback Adapter
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Authentication & Cryptography
# JWT Access Token Secret (Generate using: openssl rand -base64 32)
JWT_ACCESS_SECRET=mangal_super_secure_access_secret_key_change_in_production_32char
JWT_ACCESS_EXPIRY=15m

# JWT Refresh Token Secret
JWT_REFRESH_SECRET=mangal_super_secure_refresh_secret_key_change_in_production_32char
JWT_REFRESH_EXPIRY=7d

# Session Cookie Secret
COOKIE_SECRET=mangal_cookie_signing_secret_key_change_in_prod

# Provider Modes: Set to 'mock' for offline/local development or 'live' with credentials
PROVIDER_MODE=mock

# Storage Provider (local | s3 | minio)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mangal-media-uploads

# Email Provider (console | smtp | ses | resend)
EMAIL_PROVIDER=console
EMAIL_FROM=Mangal Support <no-reply@mangal.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# SMS Provider (console | twilio | msg91)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payment Gateways (mock | razorpay | stripe)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Provider (deterministic | gemini | openai)
AI_PROVIDER=deterministic
GEMINI_API_KEY=
OPENAI_API_KEY=

# Astrology Provider (deterministic | vedic_api)
ASTROLOGY_PROVIDER=deterministic
ASTROLOGY_API_KEY=

# Video Calling Provider (mock | webrtc | twilio)
VIDEO_CALL_PROVIDER=mock
