datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BRIDE
  GROOM
  FAMILY
  PANDIT
  ORGANIZER
  ADMIN
  MODERATOR
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
  ANNULLED
}

enum Religion {
  HINDU
  SIKH
  JAIN
  BUDDHIST
  CHRISTIAN
  MUSLIM
  PARSI
  JEWISH
  OTHER
}

enum ManglikStatus {
  MANGLIK
  NON_MANGLIK
  ANSHIK_MANGLIK
  DONT_KNOW
}

enum FamilyType {
  JOINT
  NUCLEAR
  EXTENDED
}

enum DietPreference {
  VEGETARIAN
  NON_VEGETARIAN
  EGGETARIAN
  JAIN
  VEGAN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SwipeAction {
  LIKE
  DISLIKE
  SUPERLIKE
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  INITIATED
  RINGING
  CONNECTED
  COMPLETED
  MISSED
  DECLINED
}

enum MembershipTier {
  FREE
  SILVER
  GOLD
  DIAMOND
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PanditServiceType {
  KUNDLI_MATCHING
  DOSHA_ANALYSIS
  PUJA_SERVICES
  MUHURAT
  GENERAL_CONSULTATION
}

enum OrganizerServiceType {
  VENUE
  CATERING
  PHOTOGRAPHY
  VIDEOGRAPHY
  DECORATION
  DJ_MUSIC
  WEDDING_PLANNER
}

// ==========================================
// 1. Identity & Core Auth
// ==========================================

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  phone                String?      @unique
  passwordHash         String
  firstName            String
  lastName             String
  role                 Role         @default(BRIDE)
  status               UserStatus   @default(ACTIVE)
  isVerified           Boolean      @default(false)
  twoFactorEnabled     Boolean      @default(false)
  twoFactorSecret      String?
  failedLoginAttempts  Int          @default(0)
  lockoutUntil         DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  sessions             Session[]
  profile              Profile?
  identityVerifications IdentityVerification[]
  sentInterests        Interest[]   @relation("SentInterests")
  receivedInterests    Interest[]   @relation("ReceivedInterests")
  swipesGiven          Swipe[]      @relation("SwipesGiven")
  swipesReceived       Swipe[]      @relation("SwipesReceived")
  matchesAsUser1       Match[]      @relation("User1Matches")
  matchesAsUser2       Match[]      @relation("User2Matches")
  messagesSent         Message[]    @relation("SentMessages")
  callsInitiated       CallSession[] @relation("CallsInitiated")
  callsReceived        CallSession[] @relation("CallsReceived")
  panditProfile        PanditProfile?
  kundlis              KundliRecord[]
  organizerProfile     OrganizerProfile?
  bookings             Booking[]
  payments             Payment[]
  memberships          Membership[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([role, status])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  familyId         String   @default(uuid())
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model OtpVerification {
  id         String   @id @default(uuid())
  identifier String
  otpHash    String
  purpose    String   @default("LOGIN")
  attempts   Int      @default(0)
  isVerified Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, purpose])
}

// ==========================================
// 2. Profile & Preferences
// ==========================================

model Profile {
  id                 String          @id @default(uuid())
  userId             String          @unique
  gender             Gender
  dateOfBirth        DateTime
  heightCm           Int
  weightKg           Int?
  maritalStatus      MaritalStatus   @default(NEVER_MARRIED)
  religion           Religion        @default(HINDU)
  caste              String?
  subCaste           String?
  gotra              String?
  manglikStatus      ManglikStatus   @default(DONT_KNOW)
  birthPlace         String?
  birthTime          String?
  highestEducation   String?
  collegeName        String?
  occupation         String?
  companyName        String?
  annualIncomeRange  String?
  country            String          @default("India")
  state              String?
  city               String?
  address            String?
  motherTongue       String?
  diet               DietPreference  @default(VEGETARIAN)
  smoking            Boolean         @default(false)
  drinking           Boolean         @default(false)
  hasDisability      Boolean         @default(false)
  disabilityDetails  String?
  languagesKnown     String[]        @default([])
  hobbies            String[]        @default([])
  familyType         FamilyType      @default(NUCLEAR)
  fatherOccupation   String?
  motherOccupation   String?
  brothersCount      Int             @default(0)
  sistersCount       Int             @default(0)
  familyIncome       String?
  bio                String?
  completenessScore  Int             @default(20)
  isProfilePublic    Boolean         @default(true)
  isPhotoVisible     Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos             ProfilePhoto[]
  partnerPreference  PartnerPreference?

  @@index([gender, religion, maritalStatus])
  @@index([city, state])
}

model ProfilePhoto {
  id         String   @id @default(uuid())
  profileId  String
  fileUrl    String
  isPrimary  Boolean  @default(false)
  isApproved Boolean  @default(true)
  isPrivate  Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model PartnerPreference {
  id                 String          @id @default(uuid())
  profileId          String          @unique
  minAge             Int             @default(21)
  maxAge             Int             @default(35)
  minHeightCm        Int             @default(150)
  maxHeightCm        Int             @default(190)
  maritalStatus      MaritalStatus[] @default([])
  religions          Religion[]      @default([])
  castes             String[]        @default([])
  manglikPreference  ManglikStatus   @default(DONT_KNOW)
  preferredCities    String[]        @default([])
  minIncome          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  profile            Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. Verification & Trust
// ==========================================

model IdentityVerification {
  id                   String             @id @default(uuid())
  userId               String
  documentType         DocumentType
  documentNumberMasked String?
  documentHash         String?
  documentUrl          String
  selfieUrl            String?
  status               VerificationStatus @default(PENDING)
  reviewerNotes        String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ==========================================
// 4. Matchmaking, Swipes & Interests
// ==========================================

model Swipe {
  id        String      @id @default(uuid())
  swiperId  String
  swipedId  String
  action    SwipeAction
  createdAt DateTime    @default(now())

  swiper    User        @relation("SwipesGiven", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped    User        @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
  @@index([swiperId])
}

model Interest {
  id          String         @id @default(uuid())
  senderId    String
  receiverId  String
  status      InterestStatus @default(PENDING)
  message     String?
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sender      User           @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User           @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Match {
  id                 String        @id @default(uuid())
  user1Id            String
  user2Id            String
  compatibilityScore Int           @default(75)
  matchReasons       String[]      @default([])
  isChatUnlocked     Boolean       @default(true)
  isCallUnlocked     Boolean       @default(true)
  createdAt          DateTime      @default(now())

  user1              User          @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2              User          @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)
  conversation       Conversation?

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

// ==========================================
// 5. Real-Time Chat & Calling
// ==========================================

model Conversation {
  id            String    @id @default(uuid())
  matchId       String    @unique
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages      Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  messageType    String       @default("TEXT")
  mediaUrl       String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model CallSession {
  id              String     @id @default(uuid())
  callerId        String
  receiverId      String
  callType        CallType   @default(AUDIO)
  status          CallStatus @default(INITIATED)
  durationSeconds Int        @default(0)
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime   @default(now())

  caller          User       @relation("CallsInitiated", fields: [callerId], references: [id], onDelete: Cascade)
  receiver        User       @relation("CallsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
}

// ==========================================
// 6. Pandit & Kundli Milan
// ==========================================

model PanditProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  experienceYears    Int                 @default(5)
  specializations    PanditServiceType[] @default([KUNDLI_MATCHING, DOSHA_ANALYSIS])
  languages          String[]            @default(["Hindi", "Sanskrit"])
  bio                String?
  perConsultationFee Decimal             @default(501.00) @db.Decimal(10, 2)
  rating             Decimal             @default(5.0) @db.Decimal(3, 2)
  isVerified         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KundliRecord {
  id                  String   @id @default(uuid())
  userId              String
  birthDate           DateTime
  birthTime           String
  birthPlace          String
  rasi                String?
  nakshatra           String?
  lagna               String?
  planetaryPositions  Json?
  chartSvgUrl         String?
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// 7. Wedding Marketplace
// ==========================================

model OrganizerProfile {
  id           String                @id @default(uuid())
  userId       String                @unique
  businessName String
  serviceTypes OrganizerServiceType[] @default([WEDDING_PLANNER])
  description  String?
  city         String
  address      String?
  rating       Decimal               @default(5.0) @db.Decimal(3, 2)
  isVerified   Boolean               @default(false)
  portfolioUrls String[]             @default([])
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings     OrganizerListing[]
}

model OrganizerListing {
  id           String               @id @default(uuid())
  organizerId  String
  title        String
  serviceType  OrganizerServiceType
  description  String
  startingPrice Decimal             @db.Decimal(10, 2)
  images       String[]             @default([])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  organizer    OrganizerProfile     @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
}

// ==========================================
// 8. Bookings & Payments
// ==========================================

model Booking {
  id             String        @id @default(uuid())
  userId         String
  providerType   String
  providerId     String
  serviceTitle   String
  scheduledDate  DateTime
  status         String        @default("CONFIRMED")
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment        Payment?

  @@index([userId])
}

model Payment {
  id           String        @id @default(uuid())
  bookingId    String?       @unique
  userId       String
  gateway      String        @default("MOCK")
  orderId      String
  paymentId    String?
  signature    String?
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("INR")
  status       PaymentStatus @default(SUCCESS)
  receiptUrl   String?
  createdAt    DateTime      @default(now())

  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// 9. Membership & Subscriptions
// ==========================================

model Membership {
  id        String         @id @default(uuid())
  userId    String
  tier      MembershipTier @default(FREE)
  startDate DateTime       @default(now())
  endDate   DateTime
  isActive  Boolean        @default(true)
  autoRenew Boolean        @default(false)
  features  String[]       @default([])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// ==========================================
// 10. Notifications & Audit Logs
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  channel   String   @default("IN_APP")
  isRead    Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  targetEntity String
  targetId     String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetEntity, targetId])
}
